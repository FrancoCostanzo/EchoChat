---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';

const REPO_URL = 'https://github.com/FrancoCostanzo/EchoChat';

// Prefijo de subruta para links internos (ver base en astro.config.mjs)
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

// Iconos SVG (trazos estilo lucide) por feature
const features = [
	{
		icon: 'message',
		title: 'Mensajería',
		items: ['Directos y grupales', 'Edición e historial', 'Reacciones y threads', 'Búsqueda full-text', 'Fijados, guardados y borradores'],
	},
	{
		icon: 'video',
		title: 'Llamadas',
		items: ['Voz y video (1:1 y grupal)', 'Compartir pantalla', 'Conferencias', 'Grabación con consentimiento', 'Estadísticas de calidad'],
	},
	{
		icon: 'hash',
		title: 'Canales',
		items: ['Categorías y canales oficiales', 'Acceso abierto / invitación', 'Roles por miembro', 'Archivar, silenciar, fijar'],
	},
	{
		icon: 'megaphone',
		title: 'Difusiones',
		items: ['Listas de difusión', 'Envío masivo sin visibilidad cruzada', 'Programadas', 'Seguimiento de entrega y lectura'],
	},
	{
		icon: 'chart',
		title: 'Encuestas',
		items: ['Embebidas en mensajes', 'Anónimas y multi-opción', 'Conteo en tiempo real', 'Cierre y expiración'],
	},
	{
		icon: 'shield',
		title: 'Seguridad',
		items: ['JWT access + refresh', '2FA TOTP con backup', 'RBAC global y por conversación', 'Helmet, rate limiting, CORS'],
	},
	{
		icon: 'folder',
		title: 'Archivos',
		items: ['Almacenamiento en MinIO (S3)', 'Imágenes, video, audio, docs', 'URLs prefirmadas con TTL'],
	},
	{
		icon: 'bell',
		title: 'Notificaciones',
		items: ['In-app en tiempo real', 'Preferencias por evento', 'Horarios de silencio', 'Contador de no leídas'],
	},
	{
		icon: 'globe',
		title: 'i18n y temas',
		items: ['Español · Inglés · Portugués', 'Claro / oscuro / sistema', '6 colores de acento'],
	},
];

const platforms = [
	{ icon: 'web', name: 'Web', tech: 'React 19 + Vite', status: 'En desarrollo', ok: true },
	{ icon: 'desktop', name: 'Desktop', tech: 'Electron', status: 'Planificado', ok: false },
	{ icon: 'mobile', name: 'Mobile', tech: 'React Native + Expo', status: 'Planificado', ok: false },
];

const stack = [
	{ group: 'Frontend', tags: ['React 19', 'Vite', 'Tailwind CSS 4', 'HeroUI', 'Zustand', 'React Router 7', 'Framer Motion', 'i18next'] },
	{ group: 'Backend', tags: ['Node.js', 'Express 4', 'Socket.IO', 'Joi', 'Pino', 'JWT', 'Multer'] },
	{ group: 'Datos y almacenamiento', tags: ['PostgreSQL 15+', 'MinIO (S3)'] },
	{ group: 'Infraestructura', tags: ['Docker', 'Docker Compose', 'Nginx'] },
];

const numbers = [
	{ v: '30+', k: 'tablas PostgreSQL' },
	{ v: '20+', k: 'índices optimizados' },
	{ v: '8', k: 'buckets MinIO' },
	{ v: '3', k: 'idiomas' },
	{ v: '6', k: 'colores de acento' },
];

const installCmd = `git clone ${REPO_URL}.git
cd EchoChat && cp .env.example .env
docker compose up -d`;
---

<PortfolioLayout title="EchoChat — Mensajería empresarial en tiempo real">
	<!-- Hero -->
	<section class="hero">
		<div class="container hero-inner">
			<div class="hero-copy">
				<span class="eyebrow" data-reveal><span class="dot"></span> Open source · AGPL-3.0 · Self-hosted</span>
				<h1 data-reveal style="--reveal-delay: 80ms">
					Mensajería empresarial<br /><span class="grad">en tiempo real</span>
				</h1>
				<p class="lead" data-reveal style="--reveal-delay: 160ms">
					Plataforma de comunicación interna full-stack: mensajes, canales, llamadas,
					difusiones, encuestas y archivos. Todo en tiempo real, listo para autohospedar.
				</p>
				<div class="hero-actions" data-reveal style="--reveal-delay: 240ms">
					<a class="btn btn-primary" href={`${base}/docs`}>
						Ver documentación
						<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
					</a>
					<a class="btn btn-ghost" href={REPO_URL} target="_blank" rel="noopener">
						<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.77 5.46.77 11.73c0 4.93 3.2 9.11 7.63 10.58.56.1.77-.24.77-.54v-1.9c-3.1.67-3.76-1.5-3.76-1.5-.5-1.3-1.24-1.64-1.24-1.64-1-.7.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15 1 1.7 2.6 1.2 3.24.92.1-.72.39-1.2.7-1.47-2.47-.28-5.07-1.23-5.07-5.5 0-1.22.43-2.2 1.14-2.98-.11-.28-.5-1.4.11-2.9 0 0 .94-.3 3.07 1.13a10.6 10.6 0 0 1 5.6 0c2.12-1.43 3.06-1.13 3.06-1.13.61 1.5.22 2.62.11 2.9.71.78 1.13 1.76 1.13 2.98 0 4.28-2.6 5.21-5.08 5.49.4.34.76 1.02.76 2.06v3.05c0 .3.2.65.78.54a11.24 11.24 0 0 0 7.62-10.58C23.23 5.46 18.27.5 12 .5z"/></svg>
						GitHub
					</a>
				</div>
				<div class="hero-badges" data-reveal style="--reveal-delay: 320ms">
					<span class="pill">Node.js</span>
					<span class="pill">React 19</span>
					<span class="pill">PostgreSQL</span>
					<span class="pill">Socket.IO</span>
					<span class="pill">MinIO</span>
					<span class="pill">Docker</span>
				</div>
			</div>

			<!-- Mockup animado de la app -->
			<div class="mockup" data-reveal style="--reveal-delay: 200ms" aria-hidden="true">
				<div class="mockup-glow"></div>
				<div class="mockup-window">
					<div class="mockup-rail">
						<span class="rail-item is-brand">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 12a8 8 0 0 1 16 0v6a2 2 0 0 1-2 2h-4" />
								<path d="M8.5 12v2" /><path d="M12 10v6" /><path d="M15.5 11.5v3" />
							</svg>
						</span>
						<span class="rail-sep"></span>
						<span class="rail-item">HQ</span>
						<span class="rail-item">DV</span>
						<span class="rail-item">UX</span>
					</div>
					<div class="mockup-side">
						<div class="side-title">EchoChat HQ</div>
						<div class="side-label">Canales</div>
						<div class="side-ch is-active"><span class="hash">#</span> general</div>
						<div class="side-ch"><span class="hash">#</span> anuncios <span class="badge">2</span></div>
						<div class="side-ch"><span class="hash">#</span> desarrollo</div>
						<div class="side-ch"><span class="hash">#</span> diseño <span class="badge">5</span></div>
						<div class="side-label">Directos</div>
						<div class="side-ch">Lucía Pérez</div>
						<div class="side-ch">Raúl Gómez</div>
					</div>
					<div class="mockup-chat">
						<div class="chat-head">
							<span class="hash">#</span> general
							<span class="online"><i></i> 12 en línea</span>
						</div>
						<div class="chat-body" id="mock-body">
							<div class="mkmsg">
								<span class="avatar avatar-a">LP</span>
								<div class="msg-col">
									<div class="meta"><b class="name-a">Lucía Pérez</b><time>09:42</time></div>
									<div class="bubble">¡Deploy a staging listo! 🚀</div>
									<div class="reactions">
										<span class="reaction">🎉 3</span>
										<span class="reaction">🔥 2</span>
									</div>
								</div>
							</div>
							<div class="mkmsg is-me">
								<span class="avatar avatar-me">FC</span>
								<div class="msg-col">
									<div class="meta"><b>Vos</b><time>09:43</time></div>
									<div class="bubble">Buenísimo, subo las notas de versión ✍️</div>
								</div>
							</div>
							<div class="mkmsg">
								<span class="avatar avatar-b">RG</span>
								<div class="msg-col">
									<div class="meta"><b class="name-b">Raúl Gómez</b><time>09:45</time></div>
									<div class="bubble">Las llamadas grupales andan perfectas ✨</div>
								</div>
							</div>
						</div>
						<div class="mk-typing" id="mock-typing">
							<span class="dots"><i></i><i></i><i></i></span>
							<span id="mock-typing-name">Lucía está escribiendo…</span>
						</div>
						<div class="mk-composer">
							Escribí un mensaje…<span class="caret"></span>
							<span class="send">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Features -->
	<section class="section" id="features">
		<div class="container">
			<div class="section-head" data-reveal>
				<span class="section-eyebrow">Funciones</span>
				<h2>Todo lo que necesita una intranet de comunicación</h2>
				<p>Un backend, tres plataformas y un conjunto de funciones pensadas para empresas.</p>
			</div>
			<div class="features">
				{
					features.map((f, i) => (
						<article class="card" data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
							<div class="icon">
								{f.icon === 'message' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
										<path d="M8 9h8M8 13h5" />
									</svg>
								)}
								{f.icon === 'video' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<polygon points="23 7 16 12 23 17 23 7" />
										<rect x="1" y="5" width="15" height="14" rx="3" />
									</svg>
								)}
								{f.icon === 'hash' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M4 9h16M4 15h16M10 3L8 21M16 3l-2 18" />
									</svg>
								)}
								{f.icon === 'megaphone' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M3 11l18-7v18L3 15v-4z" />
										<path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />
									</svg>
								)}
								{f.icon === 'chart' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M3 3v18h18" />
										<path d="M7 15v3M12 10v8M17 6v12" />
									</svg>
								)}
								{f.icon === 'shield' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
										<path d="M9 12l2 2 4-4" />
									</svg>
								)}
								{f.icon === 'folder' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
									</svg>
								)}
								{f.icon === 'bell' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
										<path d="M13.73 21a2 2 0 0 1-3.46 0" />
									</svg>
								)}
								{f.icon === 'globe' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10" />
										<path d="M2 12h20" />
										<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
									</svg>
								)}
							</div>
							<h3>{f.title}</h3>
							<ul>
								{f.items.map((it) => (
									<li>{it}</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- Plataformas -->
	<section class="section" id="plataformas">
		<div class="container">
			<div class="section-head" data-reveal>
				<span class="section-eyebrow">Plataformas</span>
				<h2>Una base, múltiples plataformas</h2>
				<p>Las tres comparten el mismo backend y la mayor parte de la lógica de negocio.</p>
			</div>
			<div class="platforms">
				{
					platforms.map((p, i) => (
						<article class="platform" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
							<div class="p-icon">
								{p.icon === 'web' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10" />
										<path d="M2 12h20" />
										<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
									</svg>
								)}
								{p.icon === 'desktop' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<rect x="2" y="3" width="20" height="14" rx="2" />
										<path d="M8 21h8M12 17v4" />
									</svg>
								)}
								{p.icon === 'mobile' && (
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<rect x="5" y="2" width="14" height="20" rx="3" />
										<path d="M12 18h.01" />
									</svg>
								)}
							</div>
							<h3>{p.name}</h3>
							<div class="tech">{p.tech}</div>
							<span class={`status ${p.ok ? 'ok' : 'plan'}`}>{p.status}</span>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- Tech stack -->
	<section class="section" id="stack">
		<div class="container">
			<div class="section-head" data-reveal>
				<span class="section-eyebrow">Stack</span>
				<h2>Tech stack</h2>
				<p>Stack JavaScript de punta a punta, con herramientas maduras y probadas.</p>
			</div>
			<div class="stack-groups">
				{
					stack.map((s, i) => (
						<div class="stack-group" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
							<h4>{s.group}</h4>
							<div class="tags">
								{s.tags.map((t) => (
									<span class="tag">{t}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
			<div class="numbers" data-reveal>
				{
					numbers.map((n) => (
						<div class="num-cell">
							<b>{n.v}</b>
							<span>{n.k}</span>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Instalación -->
	<section class="section" id="instalacion">
		<div class="container">
			<div class="section-head" data-reveal>
				<span class="section-eyebrow">Instalación</span>
				<h2>De cero a producción en 3 comandos</h2>
				<p>Docker Compose levanta PostgreSQL, MinIO, backend y frontend con un solo comando.</p>
			</div>
			<div class="terminal">
				<div class="terminal-bar">
					<i></i><i></i><i></i>
					<span>~/EchoChat</span>
					<button class="copy-btn" id="copy-install" data-cmd={installCmd}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="9" y="9" width="13" height="13" rx="2" />
							<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
						</svg>
						<span>copiar</span>
					</button>
				</div>
				<div class="terminal-body">
					<div class="tline cmd" style="--tl-delay: 0ms"><span class="p">$</span>git clone https://github.com/FrancoCostanzo/EchoChat.git</div>
					<div class="tline cmd" style="--tl-delay: 250ms"><span class="p">$</span>cd EchoChat && cp .env.example .env</div>
					<div class="tline cmd" style="--tl-delay: 500ms"><span class="p">$</span>docker compose up -d</div>
					<div class="tline dim" style="--tl-delay: 750ms">[+] Running 4/4</div>
					<div class="tline ok" style="--tl-delay: 900ms">  ✔ Container echochat-postgres   Started</div>
					<div class="tline ok" style="--tl-delay: 1050ms">  ✔ Container echochat-minio      Started</div>
					<div class="tline ok" style="--tl-delay: 1200ms">  ✔ Container echochat-backend    Started</div>
					<div class="tline ok" style="--tl-delay: 1350ms">  ✔ Container echochat-frontend   Started</div>
					<div class="tline dim" style="--tl-delay: 1600ms">→ listo en http://localhost:80<span class="cursor"></span></div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section">
		<div class="container">
			<div class="cta" data-reveal>
				<h2>¿Listo para probarlo?</h2>
				<p>Levantalo con Docker en minutos o explorá el código y contribuí.</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href={`${base}/docs/instalacion`}>
						Empezar ahora
						<svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
					</a>
					<a class="btn btn-ghost" href={`${base}/faq`}>Ver FAQ</a>
				</div>
			</div>
		</div>
	</section>

	<script is:inline>
		// ── Chat del hero: conversación en vivo (loop) ──
		(() => {
			const body = document.getElementById('mock-body');
			const typing = document.getElementById('mock-typing');
			const typingName = document.getElementById('mock-typing-name');
			if (!body || !typing) return;
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

			const script = [
				{ who: 'a', name: 'Lucía Pérez', text: 'La búsqueda full-text quedó volando ⚡', time: '09:47' },
				{ who: 'me', name: 'Vos', text: 'Índice pg_trgm, &lt;40ms en 2M de filas 😎', time: '09:48' },
				{ who: 'b', name: 'Raúl Gómez', text: 'Subí una encuesta a #general, voten 📊', time: '09:50' },
				{ who: 'a', name: 'Lucía Pérez', text: 'Las difusiones programadas ya salieron 📣', time: '09:52' },
				{ who: 'me', name: 'Vos', text: 'Release v1.0 α listo para el viernes 🎯', time: '09:53' },
				{ who: 'b', name: 'Raúl Gómez', text: 'Grabación de llamadas con consentimiento ✅', time: '09:55' },
			];
			let i = 0;

			const addMsg = (m) => {
				const el = document.createElement('div');
				el.className = 'mkmsg' + (m.who === 'me' ? ' is-me' : '');
				const initials = m.who === 'me' ? 'FC' : m.who === 'a' ? 'LP' : 'RG';
				const avatarCls = m.who === 'me' ? 'avatar-me' : m.who === 'a' ? 'avatar-a' : 'avatar-b';
				const nameCls = m.who === 'a' ? 'name-a' : m.who === 'b' ? 'name-b' : '';
				el.innerHTML =
					`<span class="avatar ${avatarCls}">${initials}</span>` +
					`<div class="msg-col"><div class="meta"><b class="${nameCls}">${m.name}</b><time>${m.time}</time></div>` +
					`<div class="bubble">${m.text}</div></div>`;
				body.appendChild(el);
				while (body.children.length > 7) body.removeChild(body.firstElementChild);
			};

			const cycle = () => {
				const m = script[i % script.length];
				i++;
				if (m.who !== 'me') {
					typingName.textContent = `${m.name.split(' ')[0]} está escribiendo…`;
					typing.classList.add('is-on');
				}
				setTimeout(() => {
					typing.classList.remove('is-on');
					addMsg(m);
					setTimeout(cycle, 2600 + Math.random() * 1200);
				}, m.who === 'me' ? 400 : 1900);
			};
			setTimeout(cycle, 2600);
		})();

		// ── Botón copiar del terminal ──
		(() => {
			const btn = document.getElementById('copy-install');
			if (!btn) return;
			btn.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(btn.dataset.cmd);
					btn.classList.add('is-copied');
					btn.querySelector('span').textContent = 'copiado ✓';
					setTimeout(() => {
						btn.classList.remove('is-copied');
						btn.querySelector('span').textContent = 'copiar';
					}, 1400);
				} catch (e) {}
			});
		})();
	</script>
</PortfolioLayout>
