---
import SocialIcons from 'virtual:starlight/components/SocialIcons';
---

{/* Tema e idioma viven en la topbar; aquí solo redes en el drawer móvil. */}
<div class="mobile-preferences sl-flex">
	<div class="social-icons">
		<SocialIcons />
	</div>
</div>

<style>
	@layer starlight.core {
		.social-icons {
			display: flex;
			margin-inline-end: auto;
			gap: 1rem;
			align-items: center;
			padding-block: 0.75rem;
		}
		.social-icons:empty {
			display: none;
		}
		.mobile-preferences {
			justify-content: space-between;
			flex-wrap: wrap;
			border-top: 1px solid var(--sl-color-gray-6);
			column-gap: 1rem;
			padding: 0.35rem 0 0.15rem;
		}
		.mobile-preferences:not(:has(.social-icons:not(:empty))) {
			display: none;
		}
	}
</style>
