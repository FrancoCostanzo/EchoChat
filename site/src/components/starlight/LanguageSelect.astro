---
import context from 'virtual:starlight/project-context';
import config from 'virtual:starlight/user-config';

/**
 * Equivalent pathname for the current page in another locale.
 * Mirrors Starlight's localizedUrl for our locale map (root/en/pt).
 */
function localizedPathname(locale: string | undefined): string {
	const url = new URL(Astro.url);
	const trailingSlash = context.trailingSlash;
	const locales = config.locales ?? {};
	const localeKeys = Object.keys(locales).filter((k) => k !== 'root');

	let target = locale === 'root' ? '' : (locale ?? '');
	const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
	let path = url.pathname;
	if (base && path.startsWith(base)) {
		path = path.slice(base.length) || '/';
	}

	const parts = path.split('/');
	// parts[0] is '' because path starts with /
	const first = parts[1];
	const inLocale = first && localeKeys.includes(first);

	if (inLocale) {
		if (target) parts[1] = target;
		else parts.splice(1, 1);
	} else if (target) {
		parts.splice(1, 0, target);
	}

	let next = parts.join('/') || '/';
	if (next.length > 1 && next.endsWith('/') && trailingSlash === 'never') {
		next = next.slice(0, -1);
	} else if (!next.endsWith('/') && trailingSlash === 'always' && !next.includes('.')) {
		next += '/';
	}

	return `${base}${next === '' ? '/' : next}`;
}

const shortLabel: Record<string, string> = {
	root: 'ES',
	es: 'ES',
	en: 'EN',
	pt: 'PT',
};

const currentLocale = Astro.locals.starlightRoute.locale ?? 'root';
const currentShort = shortLabel[currentLocale] ?? String(currentLocale).toUpperCase();
const label = Astro.locals.t('languageSelect.accessibleLabel');
---

{
	config.isMultilingual && (
		<starlight-lang-select class="echo-select" data-open="false">
			<button
				type="button"
				class="echo-select__trigger"
				aria-expanded="false"
				aria-haspopup="listbox"
				aria-label={label}
			>
				<span class="echo-select__icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="10"></circle>
						<path d="M2 12h20"></path>
						<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
					</svg>
				</span>
				<span class="echo-select__value">{currentShort}</span>
				<svg class="echo-select__caret" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</button>
			<div class="echo-select__menu" role="listbox" aria-label={label} hidden>
				{Object.entries(config.locales!).map(([code, locale]) => {
					const href = localizedPathname(code);
					const active = (code === 'root' ? 'root' : code) === currentLocale;
					const short = shortLabel[code] ?? code.toUpperCase();
					return (
						<a
							href={href}
							class:list={['echo-select__option', { 'is-active': active }]}
							role="option"
							aria-selected={active ? 'true' : 'false'}
							hreflang={locale?.lang}
							data-short={short}
						>
							<span class="echo-select__option-short">{short}</span>
							<span class="echo-select__option-label">{locale!.label}</span>
						</a>
					);
				})}
			</div>
		</starlight-lang-select>
	)
}

<script>
	class StarlightLanguageSelect extends HTMLElement {
		#trigger: HTMLButtonElement | null = null;
		#menu: HTMLElement | null = null;

		connectedCallback() {
			this.#trigger = this.querySelector('.echo-select__trigger');
			this.#menu = this.querySelector('.echo-select__menu');

			this.#trigger?.addEventListener('click', (ev) => {
				ev.stopPropagation();
				this.#setOpen(this.dataset.open !== 'true');
			});

			document.addEventListener('click', this.#onDocClick);
			document.addEventListener('keydown', this.#onKeyDown);
		}

		disconnectedCallback() {
			document.removeEventListener('click', this.#onDocClick);
			document.removeEventListener('keydown', this.#onKeyDown);
		}

		#onDocClick = (ev: MouseEvent) => {
			if (!this.contains(ev.target as Node)) this.#setOpen(false);
		};

		#onKeyDown = (ev: KeyboardEvent) => {
			if (ev.key === 'Escape') this.#setOpen(false);
		};

		#setOpen(open: boolean) {
			this.dataset.open = String(open);
			this.#trigger?.setAttribute('aria-expanded', String(open));
			if (this.#menu) this.#menu.hidden = !open;
		}
	}

	if (!customElements.get('starlight-lang-select')) {
		customElements.define('starlight-lang-select', StarlightLanguageSelect);
	}
</script>

<style>
	.echo-select {
		position: relative;
		display: inline-flex;
	}
	.echo-select__trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 2.15rem;
		padding: 0 0.55rem 0 0.65rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-hairline);
		background: color-mix(in oklch, var(--sl-color-gray-6) 70%, transparent);
		color: var(--sl-color-white);
		font-family: inherit;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			background 0.15s ease,
			color 0.15s ease;
	}
	.echo-select__trigger:hover {
		border-color: color-mix(in oklch, var(--sl-color-accent) 45%, transparent);
		background: color-mix(in oklch, var(--sl-color-gray-5) 45%, transparent);
	}
	.echo-select__icon {
		display: grid;
		place-items: center;
		width: 0.95rem;
		height: 0.95rem;
		color: var(--sl-color-accent-high);
	}
	.echo-select__icon svg {
		width: 0.95rem;
		height: 0.95rem;
	}
	.echo-select__caret {
		width: 12px;
		height: 12px;
		opacity: 0.65;
		transition: transform 0.2s var(--echo-ease, cubic-bezier(0.22, 1, 0.36, 1));
	}
	.echo-select[data-open='true'] .echo-select__caret {
		transform: rotate(180deg);
	}
	.echo-select__menu {
		position: absolute;
		top: calc(100% + 0.4rem);
		right: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		min-width: 10.5rem;
		padding: 0.3rem;
		border-radius: 0.75rem;
		border: 1px solid var(--sl-color-hairline);
		background: color-mix(in oklch, var(--sl-color-black) 88%, transparent);
		backdrop-filter: blur(16px) saturate(1.2);
		-webkit-backdrop-filter: blur(16px) saturate(1.2);
		box-shadow: var(--echo-shadow);
	}
	:global(:root[data-theme='light']) .echo-select__menu {
		background: color-mix(in oklch, white 94%, transparent);
	}
	.echo-select__menu[hidden] {
		display: none;
	}
	.echo-select__option {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.5rem 0.7rem;
		border-radius: 0.5rem;
		color: var(--sl-color-gray-2);
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}
	.echo-select__option:hover {
		color: var(--sl-color-white);
		background: color-mix(in oklch, var(--sl-color-gray-5) 45%, transparent);
	}
	.echo-select__option.is-active {
		color: var(--sl-color-white);
		background: color-mix(in oklch, var(--sl-color-accent) 18%, transparent);
	}
	.echo-select__option-short {
		font-family: var(--sl-font-mono), ui-monospace, monospace;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		opacity: 0.8;
		min-width: 1.4rem;
	}
	.echo-select__option-label {
		font-weight: 500;
	}

	@media (max-width: 49.99rem) {
		:global(.header-tools) .echo-select__trigger {
			width: 2.15rem;
			height: 2.15rem;
			min-width: 2.15rem;
			padding: 0;
			justify-content: center;
			gap: 0;
		}
		:global(.header-tools) .echo-select__icon,
		:global(.header-tools) .echo-select__caret {
			display: none;
		}
		:global(.header-tools) .echo-select__value {
			font-size: 0.68rem;
			letter-spacing: 0.04em;
			max-width: none;
		}
	}
</style>
