---
import '../styles/site.css';
import BrandMark from '../components/BrandMark.astro';
import {
	type Lang,
	type Page,
	LANGS,
	LANG_LABELS,
	pagePaths,
	docsPaths,
	getStrings,
} from '../i18n/strings';

interface Props {
	title: string;
	description?: string;
	lang?: Lang;
	page?: Page;
}

const {
	title,
	description,
	lang = 'es',
	page = 'home',
} = Astro.props;

const t = getStrings(lang);
const resolvedDescription = description ?? t.meta.description;

const REPO_URL = 'https://github.com/FrancoCostanzo/EchoChat';

// Prefijo de subruta ('' en raíz, '/EchoChat' en GitHub Pages) para que los
// links internos funcionen en cualquier hosting. Ver base en astro.config.mjs.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const homeHref = `${base}${pagePaths.home[lang]}`;
const featuresHref = `${base}${pagePaths.home[lang]}#features`;
const docsHref = `${base}${docsPaths[lang]}`;
const faqHref = `${base}${pagePaths.faq[lang]}`;
const ogImage = new URL(`${base}/icon-512.png`, Astro.site ?? 'https://echochat.netlify.app').href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<link rel="manifest" href={`${base}/site.webmanifest`} />
		<meta name="theme-color" content="#0B0D14" />
		<title>{title}</title>
		<meta name="description" content={resolvedDescription} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={resolvedDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImage} />
		<!-- Tipografías del design system de la app: Clash Display (jerarquía) + Satoshi (UI) -->
		<link rel="preconnect" href="https://api.fontshare.com" crossorigin />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=satoshi@400,500,600,700&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<!-- Sincroniza el tema con Starlight (clave localStorage 'starlight-theme') antes de pintar -->
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('starlight-theme');
				const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
				const theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body>
		<div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
		<header class="site-header" id="site-header">
			<div class="inner">
				<a href={homeHref} class="brand">
					<BrandMark />
					<span class="brand-name">EchoChat</span>
					<span class="brand-ver">v1.0 α</span>
				</a>
				<nav class="nav" id="site-nav" data-open="false">
					<div class="nav-links">
						<a href={homeHref}>{t.nav.home}</a>
						<a href={featuresHref}>{t.nav.features}</a>
						{/* viewport: precarga docs apenas se ve el link, así la view
						    transition ya tiene el documento listo en el primer click */}
						<a href={docsHref} data-astro-prefetch="viewport">{t.nav.docs}</a>
						<a href={faqHref} data-astro-prefetch="viewport">{t.nav.faq}</a>
					</div>
					<a class="nav-github" href={REPO_URL} target="_blank" rel="noopener" aria-label={t.nav.github}>
						<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M12 .5C5.73.5.77 5.46.77 11.73c0 4.93 3.2 9.11 7.63 10.58.56.1.77-.24.77-.54v-1.9c-3.1.67-3.76-1.5-3.76-1.5-.5-1.3-1.24-1.64-1.24-1.64-1-.7.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15 1 1.7 2.6 1.2 3.24.92.1-.72.39-1.2.7-1.47-2.47-.28-5.07-1.23-5.07-5.5 0-1.22.43-2.2 1.14-2.98-.11-.28-.5-1.4.11-2.9 0 0 .94-.3 3.07 1.13a10.6 10.6 0 0 1 5.6 0c2.12-1.43 3.06-1.13 3.06-1.13.61 1.5.22 2.62.11 2.9.71.78 1.13 1.76 1.13 2.98 0 4.28-2.6 5.21-5.08 5.49.4.34.76 1.02.76 2.06v3.05c0 .3.2.65.78.54a11.24 11.24 0 0 0 7.62-10.58C23.23 5.46 18.27.5 12 .5z"
							/>
						</svg>
						<span class="nav-github-label">{t.nav.github}</span>
					</a>
					<div class="lang-switch" data-open="false">
						<button
							type="button"
							class="lang-trigger"
							id="lang-trigger"
							aria-expanded="false"
							aria-haspopup="listbox"
							aria-controls="lang-menu"
							aria-label={t.nav.langLabel}
						>
							<span class="lang-current">{LANG_LABELS[lang]}</span>
							<svg class="lang-caret" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<div class="lang-menu" id="lang-menu" role="listbox" aria-label={t.nav.langLabel} hidden>
							{
								LANGS.map((code) => (
									<a
										href={`${base}${pagePaths[page][code]}`}
										class:list={['lang-option', { 'is-active': code === lang }]}
										role="option"
										aria-selected={code === lang ? 'true' : 'false'}
										hreflang={code}
									>
										{LANG_LABELS[code]}
									</a>
								))
							}
						</div>
					</div>
					<button class="theme-toggle" id="theme-toggle" aria-label={t.theme.toggle}>
						<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
						</svg>
						<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</button>
					<button
						class="nav-menu-toggle"
						id="nav-menu-toggle"
						type="button"
						aria-expanded="false"
						aria-controls="site-nav-panel"
						aria-label={t.nav.menuOpen}
						data-label-open={t.nav.menuOpen}
						data-label-close={t.nav.menuClose}
					>
						<span class="nav-menu-bars" aria-hidden="true"></span>
					</button>
				</nav>
			</div>
			<div class="nav-panel" id="site-nav-panel" hidden>
				<a href={homeHref} style="--nav-i: 0">{t.nav.home}</a>
				<a href={featuresHref} style="--nav-i: 1">{t.nav.features}</a>
				<a href={docsHref} style="--nav-i: 2" data-astro-prefetch="viewport">{t.nav.docs}</a>
				<a href={faqHref} style="--nav-i: 3" data-astro-prefetch="viewport">{t.nav.faq}</a>
				<a href={REPO_URL} target="_blank" rel="noopener" style="--nav-i: 4">{t.nav.github}</a>
			</div>
			<div class="nav-scrim" id="nav-scrim" hidden></div>
		</header>

		<main>
			<slot />
		</main>

		<button class="to-top" id="to-top" type="button" aria-label={t.nav.backToTop}>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 19V5M5 12l7-7 7 7" />
			</svg>
		</button>

		<footer class="site-footer">
			<div class="container inner">
				<span class="foot-brand">
					<BrandMark size={26} class="brand-logo-sm" />
					EchoChat
				</span>
				<span>© {new Date().getFullYear()} Franco Costanzo</span>
				<span>
					{t.footer.license}
					<a href={`${REPO_URL}/blob/main/LICENSE`} target="_blank" rel="noopener">AGPL-3.0</a>
					·
					<a href={REPO_URL} target="_blank" rel="noopener">{t.footer.source}</a>
				</span>
			</div>
		</footer>

		<script is:inline>
			// Toggle de tema (sincronizado con Starlight) con revelado circular
			// desde el botón vía View Transitions API; fallback: cambio directo.
			const toggle = document.getElementById('theme-toggle');
			toggle?.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				const apply = () => {
					document.documentElement.dataset.theme = next;
					localStorage.setItem('starlight-theme', next);
				};
				const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!document.startViewTransition || reducedMotion) {
					apply();
					return;
				}
				const rect = toggle.getBoundingClientRect();
				const cx = rect.left + rect.width / 2;
				const cy = rect.top + rect.height / 2;
				const radius = Math.hypot(
					Math.max(cx, innerWidth - cx),
					Math.max(cy, innerHeight - cy)
				);
				document.documentElement.classList.add('theme-vt');
				const vt = document.startViewTransition(apply);
				vt.ready.then(() => {
					const toDark = next === 'dark';
					document.documentElement.animate(
						{
							clipPath: [
								`circle(0px at ${cx}px ${cy}px)`,
								`circle(${radius}px at ${cx}px ${cy}px)`,
							],
						},
						{
							// Oscuro: revelado más lento y vistoso; claro: un poco más ágil
							duration: toDark ? 900 : 620,
							easing: toDark
								? 'cubic-bezier(0.22, 1, 0.36, 1)'
								: 'cubic-bezier(0.33, 1, 0.68, 1)',
							pseudoElement: '::view-transition-new(root)',
						}
					);
				});
				vt.finished.finally(() => document.documentElement.classList.remove('theme-vt'));
			});

			// Reveal on scroll — respeta prefers-reduced-motion
			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const targets = document.querySelectorAll('[data-reveal], .terminal');
			if (reduced || !('IntersectionObserver' in window)) {
				targets.forEach((el) => el.classList.add('is-visible'));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add('is-visible');
								io.unobserve(e.target);
							}
						}
					},
					{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
				);
				targets.forEach((el) => io.observe(el));
			}

			// Halo que sigue al cursor en las cards de features
			document.querySelectorAll('.card').forEach((card) => {
				card.addEventListener('pointermove', (ev) => {
					const r = card.getBoundingClientRect();
					card.style.setProperty('--mx', `${((ev.clientX - r.left) / r.width) * 100}%`);
					card.style.setProperty('--my', `${((ev.clientY - r.top) / r.height) * 100}%`);
				});
			});

			// Menú móvil del header
			const menuBtn = document.getElementById('nav-menu-toggle');
			const menuPanel = document.getElementById('site-nav-panel');
			const menuScrim = document.getElementById('nav-scrim');
			const setMenu = (open) => {
				if (!menuBtn || !menuPanel) return;
				menuBtn.setAttribute('aria-expanded', String(open));
				menuBtn.setAttribute(
					'aria-label',
					open ? menuBtn.dataset.labelClose : menuBtn.dataset.labelOpen,
				);
				menuBtn.classList.toggle('is-open', open);
				menuPanel.hidden = !open;
				if (menuScrim) menuScrim.hidden = !open;
				document.body.classList.toggle('nav-open', open);
			};
			menuBtn?.addEventListener('click', () => {
				setMenu(menuBtn.getAttribute('aria-expanded') !== 'true');
			});
			menuScrim?.addEventListener('click', () => setMenu(false));
			menuPanel?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => setMenu(false));
			});
			matchMedia('(min-width: 861px)').addEventListener('change', (ev) => {
				if (ev.matches) setMenu(false);
			});

			// Scroll: barra de progreso + header compacto + botón "volver arriba".
			// Un solo handler con rAF para no recalcular en cada evento.
			const progress = document.getElementById('scroll-progress');
			const header = document.getElementById('site-header');
			const toTop = document.getElementById('to-top');
			let scrollTick = false;
			const onScroll = () => {
				const y = scrollY;
				const max = document.documentElement.scrollHeight - innerHeight;
				if (progress) progress.style.setProperty('--progress', max > 0 ? String(y / max) : '0');
				header?.classList.toggle('is-scrolled', y > 24);
				toTop?.classList.toggle('is-visible', y > innerHeight * 0.9);
				scrollTick = false;
			};
			addEventListener(
				'scroll',
				() => {
					if (!scrollTick) {
						scrollTick = true;
						requestAnimationFrame(onScroll);
					}
				},
				{ passive: true }
			);
			onScroll();
			toTop?.addEventListener('click', () => {
				scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
			});

			// Selector de idioma (dropdown)
			const langSwitch = document.querySelector('.lang-switch');
			const langTrigger = document.getElementById('lang-trigger');
			const langMenu = document.getElementById('lang-menu');
			const setLangOpen = (open) => {
				if (!langSwitch || !langTrigger || !langMenu) return;
				langSwitch.dataset.open = String(open);
				langTrigger.setAttribute('aria-expanded', String(open));
				langMenu.hidden = !open;
			};
			langTrigger?.addEventListener('click', (ev) => {
				ev.stopPropagation();
				setLangOpen(langTrigger.getAttribute('aria-expanded') !== 'true');
			});
			document.addEventListener('click', (ev) => {
				if (langSwitch && !langSwitch.contains(ev.target)) setLangOpen(false);
			});
			document.addEventListener('keydown', (ev) => {
				if (ev.key === 'Escape') {
					setMenu(false);
					setLangOpen(false);
				}
			});
		</script>
	</body>
</html>
