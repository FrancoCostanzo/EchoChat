{
  // Mismo criterio que frontend/tsconfig.json: el build real lo hace
  // electron-vite (esbuild/rollup, que transpilan sin chequear tipos) y tsc
  // corre sólo para tipar (noEmit). Por eso moduleResolution es "bundler".
  //
  // "DOM" hace falta para el preload, que corre en el contexto del renderer
  // (contextBridge, window). El main no usa nada del DOM.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "allowJs": false,
    "checkJs": false,

    "strict": true,

    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"]
  },
  "include": ["src", "electron.vite.config.ts"]
}
