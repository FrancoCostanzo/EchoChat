# ==============================================================================
# EchoChat — Frontend · Variables de Entorno
# ==============================================================================
#
# Copie este archivo como .env y ajuste los valores según su entorno.
#
#   cp .env.example .env
#
# IMPORTANTE:
#   - En Vite, solo las variables con prefijo VITE_ son expuestas al navegador.
#   - Nunca coloque secretos aquí: todo lo que tenga prefijo VITE_ es visible
#     en el bundle final de producción.
#   - Nunca commitee el archivo .env real.
#
# NOTA SOBRE EL PROXY:
#   En desarrollo, las peticiones a /api y /socket.io se redirigen al backend
#   automáticamente mediante el proxy de Vite (configurado en vite.config.js).
#   No es necesario definir la URL del backend aquí para desarrollo local.
#
# ==============================================================================


# ── Servidor de Desarrollo ────────────────────────────────────────────────────
#
# Variables reconocidas por Vite para el servidor de desarrollo.
# Referencia: https://vitejs.dev/config/server-options.html
#
# ℹ️  El puerto por defecto es 5173. Cambiarlo si hay conflicto con otro proceso.

VITE_PORT=5173


# ── Aplicación ────────────────────────────────────────────────────────────────

# Nombre de la aplicación. Usado para títulos, labels y textos genéricos.
VITE_APP_NAME=EchoChat

# Versión de la aplicación. Puede usarse para mostrar en la UI o en logs.
# ℹ️  Normalmente coincide con la versión en package.json.
VITE_APP_VERSION=1.0.0


# ── API (Solo producción o entornos sin proxy) ────────────────────────────────
#
# En desarrollo, el proxy de Vite (vite.config.js) redirige /api → backend,
# por lo que esta variable NO es necesaria en desarrollo.
#
# En producción (build estático servido por Nginx), el proxy está configurado
# en nginx/default.conf.template y tampoco se necesita esta variable.
#
# Solo definir si se despliega el frontend de forma standalone apuntando
# a un backend en otro dominio.
#
# Ejemplo: VITE_API_BASE_URL=https://api.echochat.miempresa.com
#
# ℹ️  Dejar vacío o comentado para desarrollo local y Docker estándar.
# VITE_API_BASE_URL=
