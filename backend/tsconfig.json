{
  // Config de build (ver docs/TYPESCRIPT_MIGRATION.md). Compila src/ a dist/
  // mezclando .ts y .js: la migración avanza capa por capa y las dos conviven.
  //
  // `checkJs` está apagado a propósito: cada archivo .js se suma al chequeo
  // poniéndole `// @ts-check` arriba, para ir migrando de a poco en vez de
  // enfrentar miles de errores de golpe. Para chequear todo: npm run typecheck:all
  //
  // IMPORTANTE: rootDir/outDir hacen que dist/ replique la estructura de src/.
  // Cinco rutas se resuelven con __dirname relativo ('../../docs', '../../.env',
  // '../../package.json'); si dist/ aplanara la estructura, se romperían en
  // runtime y no al compilar.
  "compilerOptions": {
    "target": "ES2022",
    // nodenext + package.json sin "type": "module" = CommonJS, que es lo que
    // usa todo el proyecto. TypeScript 7 quitó el viejo moduleResolution "node".
    "module": "nodenext",
    "lib": ["ES2022"],

    "allowJs": true,
    "checkJs": false,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Se endurece de a un flag por vez en la fase 8.
    "strict": false,

    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"]
}
