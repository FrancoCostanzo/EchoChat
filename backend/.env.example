# ==============================================================================
# EchoChat — Backend · Variables de Entorno
# ==============================================================================
#
# Copie este archivo como .env y ajuste los valores según su entorno.
#
#   cp .env.example .env
#
# IMPORTANTE:
#   - Nunca commitee el archivo .env real.
#   - Los valores marcados con ⚠️  DEBEN cambiarse antes de usar en producción.
#   - Los valores marcados con ℹ️  son opcionales o tienen defaults seguros.
#
# ==============================================================================


# ── General ───────────────────────────────────────────────────────────────────

# Entorno de ejecución. Afecta logs, pretty-print, mensajes de error.
# Valores: development | production | test
NODE_ENV=development

# Puerto en el que escucha el servidor Express + Socket.IO.
PORT=3000


# ── PostgreSQL ────────────────────────────────────────────────────────────────
#
# En desarrollo local, apuntar a la instancia local de PostgreSQL.
# En Docker todo-en-uno (perfil "postgres"), DB_HOST debe ser "postgres".
# En producción con BD externa, poner la IP o hostname del servidor.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=echochat
DB_USER=echochat

# ⚠️  Cambiar por una contraseña segura en producción.
DB_PASSWORD=cambie_esta_password_segura

# ℹ️  Pool de conexiones. Ajustar según la carga esperada.
DB_POOL_MIN=2
DB_POOL_MAX=20


# ── JWT (Autenticación) ───────────────────────────────────────────────────────
#
# ⚠️  El secreto JWT DEBE ser una cadena larga y aleatoria. Generarlo con:
#     node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Si se expone este valor, cualquiera puede forjar tokens de autenticación.

JWT_SECRET=genere_un_secreto_largo_y_aleatorio_aqui

# ℹ️  Duración del access token (formato: https://github.com/vercel/ms)
JWT_EXPIRES_IN=7d

# ℹ️  Duración del refresh token. Debe ser mayor que JWT_EXPIRES_IN.
JWT_REFRESH_EXPIRES_IN=30d


# ── MinIO (Almacenamiento de Archivos) ────────────────────────────────────────
#
# MinIO es el servidor de almacenamiento compatible con S3 que gestiona:
# avatares, imágenes, videos, audios, documentos, thumbnails y grabaciones.
#
# En Docker todo-en-uno (perfil "minio"), MINIO_ENDPOINT debe ser "minio".
# En producción con MinIO/S3 externo, poner la IP o hostname del servidor.

MINIO_ENDPOINT=localhost
MINIO_PORT=9000

# ⚠️  Cambiar por credenciales seguras en producción.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=cambie_esta_password_segura

# ℹ️  Activar si MinIO/S3 usa HTTPS.
MINIO_USE_SSL=false

# Endpoint público de MinIO: cómo los navegadores acceden a MinIO para descargar
# archivos mediante presigned URLs.
#
#   - Desarrollo local:    MINIO_PUBLIC_ENDPOINT=localhost
#   - Todo-en-uno Docker:  MINIO_PUBLIC_ENDPOINT=192.168.1.100  (IP del servidor)
#   - Dominio propio:      MINIO_PUBLIC_ENDPOINT=echochat.miempresa.com
#
# Si no se configura, se usa el valor de MINIO_ENDPOINT como fallback.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000

# ℹ️  Activar si el endpoint público usa HTTPS.
MINIO_PUBLIC_USE_SSL=false


# ── CORS ──────────────────────────────────────────────────────────────────────
#
# Origen(es) del frontend que tienen permiso para hacer peticiones al backend.
# Solo peticiones desde este origen serán aceptadas por el servidor.
#
#   Desarrollo:              CORS_ORIGIN=http://localhost:5173
#   Docker todo-en-uno:      CORS_ORIGIN=http://192.168.1.100
#   Dominio propio:          CORS_ORIGIN=https://echochat.miempresa.com
#
# ⚠️  No usar "*" en producción.

CORS_ORIGIN=http://localhost:5173


# ── Rate Limiting ─────────────────────────────────────────────────────────────
#
# Limita cuántas peticiones puede hacer una misma IP en un intervalo de tiempo.
# Protege contra ataques de fuerza bruta y abuso de la API.

# Ventana de tiempo en milisegundos. Por defecto: 900000 ms = 15 minutos.
RATE_LIMIT_WINDOW_MS=900000

# Número máximo de peticiones permitidas por IP en la ventana configurada.
# ℹ️  Ajustar según el número de usuarios concurrentes esperados.
RATE_LIMIT_MAX=100


# ── Logging ───────────────────────────────────────────────────────────────────
#
# Nivel mínimo de logs que se emiten. En desarrollo usar "debug" para ver
# detalles internos. En producción usar "info" o "warn".
#
# Valores (de más a menos verboso): trace | debug | info | warn | error | fatal
LOG_LEVEL=info
