# ==============================================================================
# EchoChat — Backend · Variables de Entorno
# ==============================================================================
#
# Copie este archivo como .env y ajuste los valores según su entorno.
#
#   cp .env.example .env
#
# IMPORTANTE:
#   - Nunca commitee el archivo .env real.
#   - Los valores marcados con ⚠️  DEBEN cambiarse antes de usar en producción.
#   - Los valores marcados con ℹ️  son opcionales o tienen defaults seguros.
#
# ==============================================================================


# ── General ───────────────────────────────────────────────────────────────────

# Entorno de ejecución. Afecta logs, pretty-print, mensajes de error.
# Valores: development | production | test
NODE_ENV=development

# Puerto en el que escucha el servidor Express + Socket.IO.
PORT=3000


# ── PostgreSQL ────────────────────────────────────────────────────────────────
#
# En desarrollo local, apuntar a la instancia local de PostgreSQL.
# En Docker todo-en-uno (perfil "postgres"), DB_HOST debe ser "postgres".
# En producción con BD externa, poner la IP o hostname del servidor.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=echochat
DB_USER=echochat

# ⚠️  Cambiar por una contraseña segura en producción.
DB_PASSWORD=cambie_esta_password_segura

# ℹ️  Pool de conexiones. Ajustar según la carga esperada.
DB_POOL_MIN=2
DB_POOL_MAX=20

# ℹ️  URL completa para herramientas externas (p. ej. MCP de PostgreSQL en Cursor).
#     Debe coincidir con los valores DB_* de arriba. Codificar caracteres especiales
#     de la contraseña en la URL si aplica (%40 para @, etc.).
# DATABASE_URL=postgresql://echochat:cambie_esta_password_segura@localhost:5432/echochat


# ── JWT (Autenticación) ───────────────────────────────────────────────────────
#
# ⚠️  El secreto JWT DEBE ser una cadena larga y aleatoria. Generarlo con:
#     node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Si se expone este valor, cualquiera puede forjar tokens de autenticación.

JWT_SECRET=genere_un_secreto_largo_y_aleatorio_aqui

# ℹ️  Duración del access token (formato: https://github.com/vercel/ms)
JWT_EXPIRES_IN=7d

# ℹ️  Duración del refresh token. Debe ser mayor que JWT_EXPIRES_IN.
JWT_REFRESH_EXPIRES_IN=30d


# ── Cifrado de mensajes en reposo ───────────────────────────────────────────────
#
# El contenido de los mensajes (y borradores, notas y previews) se guarda cifrado
# en la base de datos con AES-256-GCM. El servidor usa esta clave para descifrar al
# servir, de modo que la búsqueda y los previews siguen funcionando.
#
# ⚠️  Clave maestra de 32 bytes en base64. Generarla con:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
#   - Si se PIERDE esta clave, se pierden TODOS los mensajes (no hay forma de
#     descifrarlos). Respáldela de forma segura.
#   - No la commitee. Cámbiela por entorno.
#   - Para rotarla: cambie MESSAGE_ENC_KEY_ID y recifre (ver scripts/).

MESSAGE_ENC_KEY=genere_una_clave_de_32_bytes_en_base64
MESSAGE_ENC_KEY_ID=v1


# ── Primer administrador (bootstrap automático) ───────────────────────────────
#
# En el primer arranque, si no existe ningún super_admin, el backend crea este
# usuario con rol super_admin. Inicie sesión y cambie la contraseña luego.
# Deje ADMIN_PASSWORD vacío para crear el admin a mano.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambie_esta_password_de_admin
ADMIN_DISPLAY_NAME=Administrador
ADMIN_EMAIL=

# Aplicar schema + migraciones automáticamente al arrancar. "false" = manual
# con `npm run migrate`.
RUN_MIGRATIONS_ON_BOOT=true


# ── MinIO (Almacenamiento de Archivos) ────────────────────────────────────────
#
# MinIO es el servidor de almacenamiento compatible con S3 que gestiona:
# avatares, imágenes, videos, audios, documentos, thumbnails y grabaciones.
#
# En Docker todo-en-uno (perfil "minio"), MINIO_ENDPOINT debe ser "minio".
# En producción con MinIO/S3 externo, poner la IP o hostname del servidor.

MINIO_ENDPOINT=localhost
MINIO_PORT=9000

# ⚠️  Cambiar por credenciales seguras en producción.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=cambie_esta_password_segura

# ℹ️  Activar si MinIO/S3 usa HTTPS.
MINIO_USE_SSL=false

# Endpoint público de MinIO: cómo los navegadores acceden a MinIO para descargar
# archivos mediante presigned URLs.
#
#   - Desarrollo local:    MINIO_PUBLIC_ENDPOINT=localhost
#   - Todo-en-uno Docker:  MINIO_PUBLIC_ENDPOINT=192.168.1.100  (IP del servidor)
#   - Dominio propio:      MINIO_PUBLIC_ENDPOINT=echochat.miempresa.com
#
# Si no se configura, se usa el valor de MINIO_ENDPOINT como fallback.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000

# ℹ️  Activar si el endpoint público usa HTTPS.
MINIO_PUBLIC_USE_SSL=false


# ── CORS ──────────────────────────────────────────────────────────────────────
#
# Origen(es) del frontend que tienen permiso para hacer peticiones al backend.
# Solo peticiones desde este origen serán aceptadas por el servidor.
#
#   Desarrollo:              CORS_ORIGIN=http://localhost:5173
#   Docker todo-en-uno:      CORS_ORIGIN=http://192.168.1.100
#   Dominio propio:          CORS_ORIGIN=https://echochat.miempresa.com
#
# ⚠️  No usar "*" en producción.

CORS_ORIGIN=http://localhost:5173


# ── Rate Limiting ─────────────────────────────────────────────────────────────
#
# Limita cuántas peticiones puede hacer una misma IP en un intervalo de tiempo.
# Protege contra ataques de fuerza bruta y abuso de la API.

# Ventana de tiempo en milisegundos. Por defecto: 900000 ms = 15 minutos.
RATE_LIMIT_WINDOW_MS=900000

# Número máximo de peticiones permitidas por IP en la ventana configurada.
# ℹ️  Ajustar según el número de usuarios concurrentes esperados.
RATE_LIMIT_MAX=100


# ── LDAP / Active Directory ─────────────────────────────────────────────────────
#
# Integración con un directorio corporativo (AD, OpenLDAP, etc.) para:
#   - Login: los usuarios con auth_provider='ldap' validan su contraseña por bind
#     contra el directorio (no se guarda hash local).
#   - Importación/sincronización: alta y actualización de usuarios, departamentos,
#     cargos y — opcionalmente — roles a partir de grupos del directorio.
#
# ℹ️  Todo el bloque es opcional. Con LDAP_ENABLED=false EchoChat usa sólo auth local.

# Activa la integración. Requiere además LDAP_URL y LDAP_BASE_DN.
LDAP_ENABLED=false

# URL del servidor. Usar ldaps:// (636) en producción; ldap:// (389) sólo en red interna.
LDAP_URL=ldap://dc.miempresa.local:389

# Cuenta de servicio para buscar usuarios (bind inicial). Permisos de sólo lectura.
LDAP_BIND_DN=CN=svc-echochat,OU=ServiceAccounts,DC=miempresa,DC=local
LDAP_BIND_PASSWORD=cambie_esta_password_segura

# Base de búsqueda de usuarios.
LDAP_BASE_DN=OU=Usuarios,DC=miempresa,DC=local

# Filtro de búsqueda. En login, {{username}} se reemplaza por el usuario ingresado.
# AD:       (&(objectClass=user)(sAMAccountName={{username}}))
# OpenLDAP: (&(objectClass=inetOrgPerson)(uid={{username}}))
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={{username}}))

# ℹ️  Timeout de conexión/consulta en ms.
LDAP_TIMEOUT_MS=10000

# ℹ️  Con ldaps://, poner en false SÓLO si el certificado es self-signed (no recomendado).
LDAP_TLS_REJECT_UNAUTHORIZED=true

# ── Sincronización automática (job cron) ──
# Importa/actualiza usuarios en segundo plano. Independiente de la importación manual
# desde el panel admin (que funciona aunque esto esté en false).
LDAP_SYNC_ENABLED=false
# Cron del sync. Por defecto cada 6 horas. Formato estándar de 5 campos.
LDAP_SYNC_CRON=0 */6 * * *

# ── Deprovisioning ──
# Al sincronizar, deshabilita en EchoChat (status='disabled' + revoca sesiones) a los
# usuarios LDAP que ya no aparecen en el directorio o que AD marca como deshabilitados.
# ⚠️  Sólo tiene efecto si el fetch trae usuarios (guarda anti-apagón masivo).
LDAP_DEPROVISION=false

# ── Roles desde grupos ──
# Con LDAP_SYNC_ROLES=true los roles se derivan de los grupos (memberOf) del usuario
# según el mapa de abajo, reemplazando los actuales en cada sync. Con false, sólo se
# asigna LDAP_DEFAULT_ROLE a los usuarios recién creados.
LDAP_SYNC_ROLES=false
# Mapa "DN_de_grupo=rol" separado por ';'. El DN se compara sin distinguir mayúsculas.
# LDAP_GROUP_ROLE_MAP=CN=EchoAdmins,OU=Grupos,DC=miempresa,DC=local=admin; CN=Staff,OU=Grupos,DC=miempresa,DC=local=user
LDAP_DEFAULT_ROLE=user

# ── Mapeo de atributos ──
# Ajustar según el esquema del directorio. Los defaults son para Active Directory.
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DEPARTMENT=department
LDAP_ATTR_JOB_TITLE=title
LDAP_ATTR_MEMBER_OF=memberOf
LDAP_ATTR_ACCOUNT_CONTROL=userAccountControl
# Id estable del directorio. En AD es objectGUID (binario → se serializa a hex).
# En OpenLDAP suele ser entryUUID.
LDAP_ATTR_EXTERNAL_ID=objectGUID


# ── SSO / OpenID Connect (Azure AD, Google Workspace, Okta) ─────────────────────
#
# Login federado contra uno o varios proveedores de identidad OIDC. El usuario
# se crea automáticamente en el primer login (JIT provisioning) con auth_provider='oidc'.
# El client_secret nunca sale del backend; el token vuelve al frontend por el
# fragmento (#) de la URL, no por query string.
#
# ℹ️  Todo el bloque es opcional. Con OIDC_ENABLED=false EchoChat no muestra SSO.

OIDC_ENABLED=false

# Base pública del backend, para armar el redirect_uri que se registra en el IdP.
# Debe ser la URL por la que el navegador llega al backend. Si se omite, se deriva
# del request (útil detrás de un proxy que setea X-Forwarded-*).
# El redirect_uri final es: <OIDC_REDIRECT_BASE>/api/auth/sso/<provider>/callback
OIDC_REDIRECT_BASE=https://echochat.miempresa.com

# A dónde vuelve el navegador tras el login. Por defecto usa CORS_ORIGIN.
# La página /auth/callback del frontend lee el token del fragmento.
# OIDC_FRONTEND_URL=https://echochat.miempresa.com

# Rol asignado a los usuarios creados por SSO en su primer login.
OIDC_DEFAULT_ROLE=user

# Lista de proveedores habilitados (claves separadas por coma). Para cada CLAVE se
# leen las variables OIDC_<CLAVE>_*. Ejemplo con Azure AD y Google:
# OIDC_PROVIDERS=azure,google

# --- Ejemplo: Azure AD / Microsoft Entra ID ---
# OIDC_AZURE_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# OIDC_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# OIDC_AZURE_CLIENT_SECRET=cambie_esta_password_segura
# OIDC_AZURE_LABEL=Microsoft
# OIDC_AZURE_SCOPES=openid profile email

# --- Ejemplo: Google Workspace ---
# OIDC_GOOGLE_ISSUER=https://accounts.google.com
# OIDC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# OIDC_GOOGLE_CLIENT_SECRET=cambie_esta_password_segura
# OIDC_GOOGLE_LABEL=Google

# --- Ejemplo: Okta ---
# OIDC_OKTA_ISSUER=https://<dominio>.okta.com
# OIDC_OKTA_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
# OIDC_OKTA_CLIENT_SECRET=cambie_esta_password_segura
# OIDC_OKTA_LABEL=Okta


# ── SCIM 2.0 (aprovisionamiento automático) ─────────────────────────────────────
#
# Canal por el que un IdP (Okta, Azure AD/Entra) crea, actualiza y da de baja usuarios
# automáticamente — antes incluso de que inicien sesión. Cuando RR.HH. desactiva a un
# empleado en el IdP, este llama al endpoint SCIM y el acceso se corta al instante.
#
# Endpoint base a registrar en el IdP: <URL_DEL_BACKEND>/scim/v2
# Los usuarios creados por SCIM quedan con auth_provider='scim'.
#
# ℹ️  Opcional. Con SCIM_ENABLED=false el endpoint responde 403.

SCIM_ENABLED=false

# ⚠️  Bearer token estático que el IdP presenta en cada request. Debe ser largo y secreto.
#     Generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCIM_TOKEN=genere_un_token_largo_y_aleatorio_aqui

# Rol asignado a los usuarios aprovisionados por SCIM.
SCIM_DEFAULT_ROLE=user


# ── Logging ───────────────────────────────────────────────────────────────────
#
# Nivel mínimo de logs que se emiten. En desarrollo usar "debug" para ver
# detalles internos. En producción usar "info" o "warn".
#
# Valores (de más a menos verboso): trace | debug | info | warn | error | fatal
LOG_LEVEL=info
