# ==============================================================================
# EchoChat - Configuración de Despliegue
# ==============================================================================
#
# Copie este archivo como .env y ajuste los valores según su entorno.
#
# MODOS DE DESPLIEGUE:
#
#   1. Todo en uno (un solo servidor):
#      COMPOSE_PROFILES=postgres,minio
#      → Levanta PostgreSQL, MinIO, Backend y Frontend juntos.
#
#   2. Solo Backend + Frontend (BD y storage externos):
#      COMPOSE_PROFILES=
#      → Configure DB_HOST y MINIO_ENDPOINT apuntando a sus servidores existentes.
#
#   3. Mixto (ej: BD externa, MinIO local):
#      COMPOSE_PROFILES=minio
#      → Configure DB_HOST apuntando a su servidor PostgreSQL externo.
#
# ==============================================================================

# ── Perfiles de Docker Compose ───────────────────────────────────────────
# Valores posibles (separados por coma): postgres, minio, redis
COMPOSE_PROFILES=postgres,minio

# ── General ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_PORT=80

# Número de instancias del backend. Para pasar de 1 hay que configurar
# REDIS_URL (más abajo): sin Redis, las instancias no se ven entre sí.
BACKEND_REPLICAS=1

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Si usa el contenedor integrado (perfil "postgres"), DB_HOST debe ser "postgres".
# Si usa un servidor externo, ponga la IP o hostname de su servidor PostgreSQL.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=echochat
DB_USER=echochat
DB_PASSWORD=cambie_esta_password_segura
DB_POOL_MIN=2
DB_POOL_MAX=20

# ── MinIO (almacenamiento compatible con S3) ─────────────────────────────
# Si usa el contenedor integrado (perfil "minio"), MINIO_ENDPOINT debe ser "minio".
# Si usa un servidor externo, ponga la IP o hostname de su servidor MinIO/S3.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=cambie_esta_password_segura
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001

# Endpoint público de MinIO: cómo los navegadores de los usuarios acceden a MinIO
# para descargar archivos (presigned URLs).
# En modo todo-en-uno, ponga la IP o dominio público del servidor.
# Ejemplo: MINIO_PUBLIC_ENDPOINT=192.168.1.100
# Ejemplo: MINIO_PUBLIC_ENDPOINT=echochat.miempresa.com
# Si no se define, se usa el valor de MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

# ── Redis (opcional — necesario para escalar a varias instancias) ────────
# Redis comparte el estado entre instancias del backend: sin él, dos usuarios
# conectados a instancias distintas no se ven los mensajes.
# Con una sola instancia puede dejarlo vacío y todo funciona igual.
# Si usa el contenedor integrado (perfil "redis"), el host debe ser "redis".
# Ejemplo: REDIS_URL=redis://redis:6379
REDIS_URL=

# ── JWT (Autenticación) ─────────────────────────────────────────────────
# IMPORTANTE: Genere un secreto aleatorio largo. Ejemplo:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=genere_un_secreto_largo_y_aleatorio_aqui
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Cifrado de mensajes en reposo (OBLIGATORIO) ──────────────────────────
# Clave maestra AES-256-GCM (32 bytes en base64). El backend NO arranca sin
# ella. Genérela con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENC_KEY=genere_una_clave_de_32_bytes_en_base64
# Identificador de la clave activa (para rotación futura). Dejar 'v1'.
MESSAGE_ENC_KEY_ID=v1

# ── Primer administrador (bootstrap automático) ──────────────────────────
# En el primer arranque, si NO existe ningún super_admin, el backend crea este
# usuario y le asigna el rol super_admin. Después inicie sesión y cambie la
# contraseña. Si deja estos valores vacíos, deberá crear el admin a mano.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambie_esta_password_de_admin
ADMIN_DISPLAY_NAME=Administrador
# Opcional: email del administrador.
ADMIN_EMAIL=

# ── Jobs en background ───────────────────────────────────────────────────
# Los cron (presencia, difusiones programadas, sync LDAP…) corren dentro del
# proceso del backend. Con varias instancias, cada corrida la toma UNA sola
# gracias a un lock en Redis, así que puede dejar esto en "true" en todas.
# Póngalo en "false" en instancias que quiera dedicar sólo a atender tráfico.
RUN_JOBS=true

# ── Migraciones al arranque ──────────────────────────────────────────────
# El backend aplica el schema base y las migraciones pendientes al iniciar.
# Poner "false" sólo si prefiere ejecutarlas a mano con `npm run migrate`.
RUN_MIGRATIONS_ON_BOOT=true

# ── LDAP / Active Directory ──────────────────────────────────────────────
# Integración opcional con un directorio corporativo. Si LDAP_ENABLED=false
# (por defecto), el sistema funciona 100% con usuarios locales.
#
# Flujo:
#   - Importación: el admin pulsa "Importar de LDAP" en el panel → se crean/
#     actualizan usuarios con auth_provider='ldap'.
#   - Login híbrido: esos usuarios validan su contraseña por bind contra el
#     directorio; los creados a mano siguen usando contraseña local.
LDAP_ENABLED=false

# URL del servidor. Use ldaps:// para TLS. Ej: ldap://dc.empresa.local:389
LDAP_URL=ldap://dc.empresa.local:389

# Cuenta de servicio para buscar usuarios (read-only es suficiente).
LDAP_BIND_DN=CN=svc_echochat,OU=Servicios,DC=empresa,DC=local
LDAP_BIND_PASSWORD=cambie_esta_password

# Base de búsqueda de usuarios.
LDAP_BASE_DN=OU=Usuarios,DC=empresa,DC=local

# Filtro de búsqueda. {{username}} se sustituye por el usuario al iniciar sesión.
# AD típico: (&(objectClass=user)(sAMAccountName={{username}}))
# OpenLDAP:  (&(objectClass=inetOrgPerson)(uid={{username}}))
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={{username}}))

# Mapeo de atributos (defaults pensados para Active Directory).
# Para OpenLDAP: USERNAME=uid, DISPLAY_NAME=cn, EXTERNAL_ID=entryUUID
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DEPARTMENT=department
LDAP_ATTR_JOB_TITLE=title
LDAP_ATTR_EXTERNAL_ID=objectGUID

# Avanzado.
LDAP_TIMEOUT_MS=10000
# Poner en "false" para aceptar certificados TLS autofirmados (no recomendado).
LDAP_TLS_REJECT_UNAUTHORIZED=true

# ── CORS ─────────────────────────────────────────────────────────────────
# Origen(es) permitido(s) para peticiones del frontend, separados por comas.
# En modo todo-en-uno con nginx como proxy, puede usar la URL pública.
# La app de escritorio (app://echochat) se agrega sola: no hace falta listarla.
CORS_ORIGIN=http://localhost

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
