# ==============================================================================
# EchoChat - Configuración de Despliegue
# ==============================================================================
#
# Copie este archivo como .env y ajuste los valores según su entorno.
#
# MODOS DE DESPLIEGUE:
#
#   1. Todo en uno (un solo servidor):
#      COMPOSE_PROFILES=postgres,minio
#      → Levanta PostgreSQL, MinIO, Backend y Frontend juntos.
#
#   2. Solo Backend + Frontend (BD y storage externos):
#      COMPOSE_PROFILES=
#      → Configure DB_HOST y MINIO_ENDPOINT apuntando a sus servidores existentes.
#
#   3. Mixto (ej: BD externa, MinIO local):
#      COMPOSE_PROFILES=minio
#      → Configure DB_HOST apuntando a su servidor PostgreSQL externo.
#
# ==============================================================================

# ── Perfiles de Docker Compose ───────────────────────────────────────────
# Valores posibles (separados por coma): postgres, minio
COMPOSE_PROFILES=postgres,minio

# ── General ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_PORT=80

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Si usa el contenedor integrado (perfil "postgres"), DB_HOST debe ser "postgres".
# Si usa un servidor externo, ponga la IP o hostname de su servidor PostgreSQL.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=echochat
DB_USER=echochat
DB_PASSWORD=cambie_esta_password_segura
DB_POOL_MIN=2
DB_POOL_MAX=20

# ── MinIO (almacenamiento compatible con S3) ─────────────────────────────
# Si usa el contenedor integrado (perfil "minio"), MINIO_ENDPOINT debe ser "minio".
# Si usa un servidor externo, ponga la IP o hostname de su servidor MinIO/S3.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=cambie_esta_password_segura
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001

# Endpoint público de MinIO: cómo los navegadores de los usuarios acceden a MinIO
# para descargar archivos (presigned URLs).
# En modo todo-en-uno, ponga la IP o dominio público del servidor.
# Ejemplo: MINIO_PUBLIC_ENDPOINT=192.168.1.100
# Ejemplo: MINIO_PUBLIC_ENDPOINT=echochat.miempresa.com
# Si no se define, se usa el valor de MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

# ── JWT (Autenticación) ─────────────────────────────────────────────────
# IMPORTANTE: Genere un secreto aleatorio largo. Ejemplo:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=genere_un_secreto_largo_y_aleatorio_aqui
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────────────────────────────────
# Origen permitido para peticiones del frontend.
# En modo todo-en-uno con nginx como proxy, puede usar la URL pública.
CORS_ORIGIN=http://localhost

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
